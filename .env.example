# 이 파일을 .env로 복사해서 사용: cp .env.example .env
# .env는 .gitignore에 포함되어 있어 커밋되지 않는다.

# --- PostgreSQL (docker-compose와 앱이 함께 사용) ---
POSTGRES_USER=eval
POSTGRES_PASSWORD=eval_dev_password
POSTGRES_DB=eval_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://eval:eval_dev_password@localhost:5432/eval_agent

# --- Claude API (4단계부터 사용) ---
# 발급받은 키를 여기에만 넣는다. 이 파일(.env.example)에는 절대 넣지 않는다.
ANTHROPIC_API_KEY=
# 모델명은 코드에 박지 않고 여기서 지정한다.
# 개발 중에는 저렴하고 빠른 모델(예: claude-haiku-5-5)로 시작하고, 답변 품질을 비교하고 싶을 때 바꿔 본다.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- 에이전트 ---
# LLM이 도구를 부르는 최대 반복 횟수. 무한 루프와 비용 폭주를 막는 상한.
AGENT_MAX_ITERATIONS=6
# LLM 답변 한 번의 최대 길이(토큰). 너무 작으면 답변이 중간에 잘리고, 크면 비용 상한이 올라간다.
AGENT_MAX_TOKENS=2048
